import csv

student_fields = ['roll', 'name', 'age', 'email', 'phone']
student_database = "students.csv"


def display_menu():
    print("\n--- Student Information System ---")
    print("1. Add New Student")
    print("2. View Students")
    print("3. Search Student")
    print("4. Update Student")
    print("5. Delete Student")
    print("6. Exit")


def add_student():
    print("\n--- Add Student ---")

    student_data = []

    for field in student_fields:
        value = input(f"Enter {field}: ")
        student_data.append(value)

    with open(student_database, "a", newline='') as f:
        writer = csv.writer(f)
        writer.writerow(student_data)

    print("Data saved successfully!")
    input("Press any key to continue...")


def view_students():
    print("\n--- Student Records ---")

    try:
        with open(student_database, "r") as f:
            reader = csv.reader(f)

            for row in reader:
                print(row)

    except FileNotFoundError:
        print("No records found!")

    input("Press any key to continue...")


def search_student():
    print("\n--- Search Student ---")

    roll = input("Enter roll no: ")
    found = False

    try:
        with open(student_database, "r") as f:
            reader = csv.reader(f)

            for row in reader:
                if row[0] == roll:
                    print("Record Found:", row)
                    found = True
                    break

    except FileNotFoundError:
        pass

    if not found:
        print("No record found!")

    input("Press any key to continue...")


def update_student():
    print("\n--- Update Student ---")

    roll = input("Enter roll no to update: ")

    updated_rows = []
    found = False

    try:
        with open(student_database, "r") as f:
            reader = csv.reader(f)

            for row in reader:

                if row[0] == roll:

                    print("Enter new data:")

                    new_data = []

                    for field in student_fields:
                        value = input(f"Enter {field}: ")
                        new_data.append(value)

                    updated_rows.append(new_data)
                    found = True

                else:
                    updated_rows.append(row)

        with open(student_database, "w", newline='') as f:
            writer = csv.writer(f)
            writer.writerows(updated_rows)

    except FileNotFoundError:
        print("No file found!")

    if found:
        print("Record updated successfully!")
    else:
        print("Record not found!")

    input("Press any key to continue...")


def delete_student():
    print("\n--- Delete Student ---")

    roll = input("Enter roll no to delete: ")

    updated_rows = []
    found = False

    try:
        with open(student_database, "r") as f:
            reader = csv.reader(f)

            for row in reader:

                if row[0] != roll:
                    updated_rows.append(row)

                else:
                    found = True

        with open(student_database, "w", newline='') as f:
            writer = csv.writer(f)
            writer.writerows(updated_rows)

    except FileNotFoundError:
        print("No file found!")

    if found:
        print("Record deleted successfully!")
    else:
        print("Record not found!")

    input("Press any key to continue...")


# ---------------- Main Program ----------------

while True:

    display_menu()

    choice = input("Enter your choice: ")

    if choice == '1':
        add_student()

    elif choice == '2':
        view_students()

    elif choice == '3':
        search_student()

    elif choice == '4':
        update_student()

    elif choice == '5':
        delete_student()

    elif choice == '6':
        print("Thank you for using our system")
        break

    else:
        print("Invalid choice, try again!")
