def selectionSort(arr):
    n = len(arr)

    for i in range(n):
        min_index = i

        for j in range(i + 1, n):
            if arr[j] < arr[min_index]:
                min_index = j

        # swap AFTER inner loop ends
        arr[i], arr[min_index] = arr[min_index], arr[i]


# Driver Code
arr = [64, 25, 12, 22, 11]
selectionSort(arr)

print("Sorted array:")
for i in arr:
    print(i, end=" ")
